# Google AI API Key (from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase (path to service account JSON for admin SDK)
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Server
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,https://chitai-f8b4a.web.app

# Local NumPy vector DB
CHROMA_DB_PATH=./data/numpy

# RAG Settings
CHUNK_SIZE=600
CHUNK_OVERLAP=100
TOP_K_RESULTS=5

# LLM Model Priority (comma-separated)
LLM_MODELS='["gemini-3.5-flash", "gemma-4-31b-it", "gemini-3.1-flash-lite"]'

# Google AI API Key (from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase (path to service account JSON for admin SDK)
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Admin access for protected endpoints (POST /api/books/ingest).
# Comma-separated. If BOTH are empty, the ingest endpoint is fully locked
# (local ingest_folder.py still works — it bypasses the API).
ADMIN_EMAILS=
ADMIN_UIDS=

# Server
# NOTE: if the backend runs in its own LXC behind a separate proxy host,
# bind to 0.0.0.0 (or the LAN IP) — 127.0.0.1 is only reachable on the same host.
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=https://chitai-f8b4a.web.app,https://chitai-f8b4a.firebaseapp.com

# Local NumPy vector DB
NUMPY_DB_PATH=./data/numpy

# Folder with original book files served for reading (copied here on ingestion)
BOOKS_FILES_DIR=./data/books

# Ollama embeddings (separate LXC on the LAN; do NOT expose Ollama publicly)
OLLAMA_BASE_URL=http://192.168.50.106:11434
EMBEDDING_MODEL=qwen3-embedding:4b-q4_K_M
EMBEDDING_DIMENSIONS=1024

# RAG Settings
# NOTE: ingestion (BookLoader / ingest_folder.py) currently uses its own
# defaults (chunk_size=600, overlap=100). CHUNK_SIZE here is not wired into
# BookLoader yet — set it in the loader call if you want a different size.
CHUNK_SIZE=600
CHUNK_OVERLAP=100
TOP_K_RESULTS=5

# LLM Model Priority (comma-separated)
LLM_MODELS=gemini-3.5-flash,gemma-4-31b-it,gemini-3.1-flash-lite
